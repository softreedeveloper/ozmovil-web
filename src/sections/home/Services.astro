---
import SectionHeading from '@components/ui/SectionHeading.astro';
import Icon from '@components/ui/Icon.astro';
import { services, devices } from '@constants/content.js';
import { waLink } from '@utils/config.js';
---

<section id="servicios" class="section" aria-labelledby="servicios-title">
   <div class="container">
      <SectionHeading
         id="servicios-title"
         eyebrow="Servicios"
         title="Reparamos lo que más falla en tu celular"
         lead="Elige el servicio y cotízalo directo por WhatsApp. Si no sabes qué tiene tu equipo, lo revisamos."
      />

      <!-- Iconografía de servicios del manual de marca. -->
      <ul class="mt-10 flex flex-wrap justify-center gap-3" aria-label="Dispositivos que reparamos">
         {devices.map((d, i) => (
            <li
               class="w-[calc((100%-1.5rem)/3)] sm:w-[calc((100%-2.25rem)/4)] lg:w-[calc((100%-4.5rem)/7)]"
               data-reveal="scale"
               style={`transition-delay:${i * 50}ms`}
            >
               <a
                  id={`wa-dispositivo-${d.icon}`}
                  href={waLink('device', { servicio: d.name.toLowerCase() })}
                  target="_blank"
                  rel="noopener"
                  data-placement="contenido"
                  data-destination-type="whatsapp"
                  aria-label={`Cotizar reparación de ${d.name.toLowerCase()} por WhatsApp`}
                  class="spotlight group flex h-full flex-col items-center gap-3 rounded-2xl border border-line bg-surface px-2 py-5 text-center transition duration-300 hover:-translate-y-1 hover:border-brand/50 hover:shadow-glow"
                  data-spotlight
               >
                  <span class="relative grid size-12 place-items-center text-fg transition duration-500 group-hover:-translate-y-0.5 group-hover:scale-110">
                     <Icon name={d.icon} size={30} />
                     <span
                        class="absolute -bottom-0.5 left-1/2 h-1 w-5 -translate-x-1/2 rounded-full bg-brand transition-all duration-300 group-hover:w-8"
                        aria-hidden="true"
                     ></span>
                  </span>
                  <span class="text-xs font-medium leading-tight sm:text-sm">{d.name}</span>
               </a>
            </li>
         ))}
      </ul>

      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
         {services.map((s, i) => (
            <li
               class="card spotlight group flex flex-col p-6 transition duration-300 hover:-translate-y-1 hover:border-accent/40 hover:shadow-glow"
               data-spotlight
               data-reveal="scale"
               style={`transition-delay:${(i % 4) * 60}ms`}
            >
               <span class="grid size-11 place-items-center rounded-2xl bg-accent-soft text-accent transition duration-500 group-hover:-rotate-6 group-hover:scale-110 group-hover:bg-accent group-hover:text-accent-fg">
                  <Icon name={s.icon} size={22} />
               </span>
               <h3 class="mt-5 text-lg font-semibold tracking-tight">{s.name}</h3>
               <p class="mt-2 flex-1 text-sm leading-relaxed text-subtle">{s.description}</p>
               <a
                  id={`wa-servicio-${s.slug}`}
                  href={waLink('service', { servicio: s.name.toLowerCase() })}
                  target="_blank"
                  rel="noopener"
                  data-placement="contenido"
                  data-destination-type="whatsapp"
                  class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-whatsapp-text"
                  aria-label={`Cotizar ${s.name.toLowerCase()} por WhatsApp`}
               >
                  Cotizar por WhatsApp
                  <Icon name="arrow" size={16} class="transition group-hover:translate-x-0.5" />
               </a>
            </li>
         ))}
      </ul>
   </div>
</section>
