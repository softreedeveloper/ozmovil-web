---
interface Props {
   eyebrow?: string;
   title: string;
   lead?: string;
   id?: string;
   align?: 'left' | 'center';
}
const { eyebrow, title, lead, id, align = 'left' } = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center']} data-reveal>
   {eyebrow && <p class="eyebrow">{eyebrow}</p>}
   <h2 id={id} class="h2 mt-3">
      {title}
   </h2>
   {lead && <p class="lead mt-4">{lead}</p>}
</div>
