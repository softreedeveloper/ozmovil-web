{
   "extends": "astro/tsconfigs/strict",
   "include": [".astro/types.d.ts", "**/*"],
   "exclude": ["dist"],
   "compilerOptions": {
      "strict": false,
      "allowJs": true,
      "baseUrl": ".",
      "paths": {
         "@/*": ["src/*"],
         "@components/*": ["src/components/*"],
         "@layouts/*": ["src/layouts/*"],
         "@sections/*": ["src/sections/*"],
         "@styles/*": ["src/styles/*"],
         "@utils/*": ["src/utils/*"],
         "@constants/*": ["src/constants/*"]
      },
      "jsx": "react-jsx",
      "jsxImportSource": "react"
   }
}
